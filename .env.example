# Нужен только для необязательного сервера server.mjs (вход через GitHub).
# Данные GitHub App, как их получить, написано в README.md
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Адрес, по которому открывают сайт. Callback URL в GitHub App: этот адрес + /auth/callback
BASE_URL=http://localhost:3000
PORT=3000

# Только для классического OAuth App вместо GitHub App
# GITHUB_SCOPE=public_repo

# Только для GitHub Enterprise
# GITHUB_URL=https://github.example.com
# GITHUB_API_URL=https://github.example.com/api/v3

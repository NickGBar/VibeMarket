{
  "name": "vibemarket",
  "version": "0.1.0",
  "private": true,
  "description": "An autonomous market for free, open-source apps",
  "license": "MIT",
  "homepage": "https://nickgbar.github.io/VibeMarket/",
  "repository": {
    "type": "git",
    "url": "https://github.com/NickGBar/VibeMarket.git"
  },
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "stars": "node scripts/update-stars.mjs index.html",
    "robot": "node scripts/robot.mjs --dry-run",
    "locales": "node scripts/check-locales.mjs",
    "scout": "node scripts/scout.mjs --dry-run",
    "site": "node scripts/build-site.mjs _site",
    "test": "node test/robot/run.mjs"
  },
  "engines": {
    "node": ">=22.9"
  }
}
